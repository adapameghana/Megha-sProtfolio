# Canonical origin for the deployed site.
#
# Drives metadataBase, canonical URLs, Open Graph image URLs, sitemap.xml, and
# robots.txt. If this is wrong or unset in production, every one of those points
# at the wrong host.
#
# Set this in the Vercel project settings, not in a committed file.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
